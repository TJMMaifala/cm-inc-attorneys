# Copy to .env.local for local development, and set the same variables in Vercel
# (Project > Settings > Environment Variables). Never commit real values.

# Public site URL, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://cmincattorneys.co.za

# --- Consultation enquiry email (Resend, https://resend.com) ---
# Without RESEND_API_KEY and ENQUIRY_FROM_EMAIL the form will honestly report that it
# could not send, and visitors are pointed to the telephone numbers and email address.
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "CMI Website <enquiries@cmiattorneys.co.za>"
ENQUIRY_FROM_EMAIL=
# Where enquiries are delivered (comma-separate several addresses). Defaults to info@cmiattorneys.co.za.
ENQUIRY_TO_EMAIL=info@cmiattorneys.co.za

# Optional: submissions allowed per IP per 15 minutes (default 5).
# ENQUIRY_RATE_LIMIT=5

# Optional: Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GSC_VERIFICATION=
